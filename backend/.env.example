APP_NAME=ActivosB31
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# Puertos distintos a EcoLink-Platform para que ambos stacks Sail
# puedan correr a la vez en la misma máquina.
COMPOSE_PROJECT_NAME=activosb31
APP_PORT=8081
VITE_PORT=5174
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=activosb31
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@activosb31.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA (cookie) — origen del frontend Next.js
FRONTEND_URL=http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3001,127.0.0.1:3001

# Contraseña del administrador inicial creado por DatabaseSeeder
ADMIN_INITIAL_PASSWORD=

# Fotos de activos (005, FR-008): disco privado. "local" en desarrollo;
# "b2" (Backblaze B2, bucket activosb31-fotos) en produccion (decision 44).
# Ver docs/infraestructura.md y docs/despliegue.md (seccion 2).
ASSETS_DISK=local
# Firmas de entregas (007, D-002): disco privado aparte (decision 45). Sin
# definir usa el mismo de ASSETS_DISK (local en desarrollo). En produccion
# "b2_firmas" (bucket activosb31-firmas, con Object Lock).
# SIGNATURES_DISK=
# M-3: el disco local sirve /storage (URLs firmadas) solo con true. Solo en
# desarrollo: en producción va en false o sin definir (fotos y firmas en B2).
LOCAL_DISK_SERVE=true
# Backblaze B2 (API compatible con S3). Región del bucket, p. ej. us-east-005;
# endpoint https://s3.<region>.backblazeb2.com. Application keys limitadas a
# un bucket cada una (nunca la master key: no sirve para la API S3).
B2_REGION=
B2_ENDPOINT=
# Fotos (activosb31-fotos): llave de lectura, escritura y borrado.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
# Firmas (activosb31-firmas): llave de lectura y escritura, sin deleteFiles
# ni bypassGovernance.
B2_SIGNATURES_ACCESS_KEY_ID=
B2_SIGNATURES_SECRET_ACCESS_KEY=
B2_SIGNATURES_BUCKET=

# Proxy de Vercel (TrustVercelProxy): secreto compartido con vercel.json
# (cabecera X-Proxy-Secret). Vacío en desarrollo. En producción, un valor
# aleatorio largo (openssl rand -hex 32), el mismo en Render y en Vercel.
VERCEL_PROXY_SECRET=
# Solo durante una rotación: el secreto anterior, aceptado hasta que Vercel
# use el nuevo (docs/despliegue.md). Vacío el resto del tiempo.
VERCEL_PROXY_SECRET_PREVIOUS=
# true: rechaza con 403 lo que no llegue por el proxy (salvo /up).
VERCEL_PROXY_REQUIRED=false
