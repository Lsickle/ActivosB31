# Imagen de producción para Render (Web Service tipo Docker).
# En Render: Root Directory = backend, Dockerfile Path = Dockerfile.render,
# variables de entorno según .env.example (APP_KEY, DB_*, FRONTEND_URL,
# SANCTUM_STATEFUL_DOMAINS, SESSION_DOMAIN, ADMIN_INITIAL_PASSWORD).

FROM php:8.4-cli-alpine

# Instalar dependencias del sistema y herramientas de compilación
RUN apk add --no-cache \
    postgresql-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    freetype-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    oniguruma-dev \
    icu-dev \
    $PHPIZE_DEPS

# Instalar extensiones de PHP requeridas por Laravel + PostgreSQL. GD con
# WebP (M-2): las fotos de activos aceptan JPEG, PNG y WebP (FR-008). exif:
# Intervention lo usa para orientar las fotos de celular antes de quitarles
# los metadatos.
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install \
        pdo \
        pdo_pgsql \
        bcmath \
        zip \
        gd \
        mbstring \
        intl \
        exif

# php.ini de producción (M-1): memory_limit y límites de subida acordes a
# las fotos de activos (4 MB, 24 Mpx).
COPY docker/php-production.ini $PHP_INI_DIR/conf.d/zz-activosb31.ini

# Copiar ejecutable oficial de Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .

# Instalar dependencias de Composer (sin dev) para producción
RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist --ignore-platform-req=php+

EXPOSE 8080

CMD php artisan migrate --force --seed && php artisan config:clear && php artisan cache:clear && php artisan route:clear && php artisan serve --host=0.0.0.0 --port=${PORT:-8080}
