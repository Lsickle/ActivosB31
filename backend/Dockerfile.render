# Imagen de producción para Render (Web Service tipo Docker). Guía completa:
# docs/despliegue.md. En Render: Root Directory = backend, Dockerfile Path =
# Dockerfile.render, Health Check Path = /up.
#
# Servidor: FrankenPHP en modo clásico (sin Octane), Caddyfile en
# docker/Caddyfile. Pendiente de seguridad 2 (CLAUDE.md): reemplaza
# `php artisan serve`.
#
# Las migraciones y el seeder NO corren al arrancar: van en el Pre-Deploy
# Command de Render, con la conexión directa de Neon (DB_MIGRATION_URL).
# Tampoco se cachea la configuración en el build (no hay variables de
# entorno): se hace al arrancar con `php artisan optimize`.

FROM dunglas/frankenphp:1.13.1-php8.4-trixie

# Extensiones: pdo_pgsql (PostgreSQL), gd (fotos y firmas; Intervention Image,
# PhpSpreadsheet), exif (orientación de fotos de celular antes de quitar los
# metadatos, Ley 1581), zip (Excel), intl, bcmath, opcache.
RUN install-php-extensions pdo_pgsql gd exif zip intl bcmath opcache

# M-2 (revisión de 005): las fotos aceptan JPEG, PNG y WebP (FR-008) y los PDF
# usan FreeType. Si GD quedó sin alguno, el build falla aquí y no en
# producción.
RUN php -r '$gd = gd_info(); foreach (["WebP Support", "JPEG Support", "FreeType Support", "PNG Support"] as $feature) { if (empty($gd[$feature])) { fwrite(STDERR, "GD sin {$feature}\n"); exit(1); } } echo "GD OK\n";'

# php.ini de producción + ajustes propios (M-1: memory_limit y límites de
# subida; R-2: max_execution_time).
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php-production.ini $PHP_INI_DIR/conf.d/zz-activosb31.ini

COPY docker/Caddyfile /etc/frankenphp/Caddyfile

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Dependencias en una capa propia: solo se reconstruye si cambia el lock.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress \
        --no-scripts --no-autoloader \
    && composer clear-cache

COPY . .

# El autoload dispara package:discover, que arranca la app sin variables de
# Render (APP_ENV cae en "production"): AppServiceProvider omite ahí el
# chequeo M-4 de ASSETS_DISK.
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views \
        storage/logs storage/app/private storage/app/public bootstrap/cache \
    && composer dump-autoload --no-dev --optimize --classmap-authoritative --no-interaction \
    && rm /usr/bin/composer

# Usuario sin privilegios (uid 10001): solo escribe en storage, bootstrap/cache
# y los directorios de Caddy. Escucha en 8080, sin capacidades extra.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin app \
    && setcap -r /usr/local/bin/frankenphp \
    && chown -R app:app storage bootstrap/cache /data/caddy /config/caddy

USER app

ENV LOG_CHANNEL=stderr \
    GOMEMLIMIT=450MiB \
    PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "php artisan optimize && exec frankenphp run --config /etc/frankenphp/Caddyfile"]
